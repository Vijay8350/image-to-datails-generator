# ---- Backend secrets (server-side ONLY — never expose to the browser) ----
# Copy this file to `.env` and paste your real keys there. NEVER put real keys
# in this example file — it is meant to be committed.
# Google Gemini (vision / field extraction)
GEMINI_API_KEY=your-gemini-api-key-here

# DeepSeek (text / copy generation)
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# ---- Server config ----
PORT=3000

# CORS: comma-separated list of allowed frontend origins.
# The bundled frontend is served from the same origin, so same-origin requests
# always work. Add extra origins here only if you host the UI separately.
FRONTEND_ORIGIN=http://localhost:3000
